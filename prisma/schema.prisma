// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  name          String
  password      String?
  githubId      String?  @unique
  avatar        String?
  bio           String?
  skills        String[] @default([])
  experienceLevel String?
  interests     String[] @default([])
  intent        String?
  location      String?
  website       String?
  twitter       String?
  linkedin      String?
  githubUrl     String?
  personality   String?
  status        String?
  badges        String[] @default([])
  activity      Json?    @default("[]")
  projects      Json?    @default("[]")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  sentLikes     Like[]    @relation("SentLikes")
  receivedLikes Like[]    @relation("ReceivedLikes")
  sentSkips     Skip[]    @relation("SentSkips")
  receivedSkips Skip[]    @relation("ReceivedSkips")
  matches1      Match[]   @relation("MatchUser1")
  matches2      Match[]   @relation("MatchUser2")
  chats         Chat[]    @relation("UserChats")
  messages      Message[]
}

model Like {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  sender     User     @relation("SentLikes", fields: [senderId], references: [id])
  receiver   User     @relation("ReceivedLikes", fields: [receiverId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([senderId, receiverId])
}

model Match {
  id        String   @id @default(uuid())
  user1Id   String
  user2Id   String
  user1     User     @relation("MatchUser1", fields: [user1Id], references: [id])
  user2     User     @relation("MatchUser2", fields: [user2Id], references: [id])
  chatId    String?  @unique
  chat      Chat?    @relation(fields: [chatId], references: [id])
  createdAt DateTime @default(now())

  @@unique([user1Id, user2Id])
}

model Chat {
  id           String    @id @default(uuid())
  participants User[]    @relation("UserChats")
  match        Match?
  messages     Message[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Message {
  id        String   @id @default(uuid())
  chatId    String
  chat      Chat     @relation(fields: [chatId], references: [id])
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])
  content   String
  createdAt DateTime @default(now())
}

model Skip {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  sender     User     @relation("SentSkips", fields: [senderId], references: [id])
  receiver   User     @relation("ReceivedSkips", fields: [receiverId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([senderId, receiverId])
}
