// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  name          String
  password      String?
  githubId      String?  @unique
  avatar        String?
  bio           String?
  skills        String[] @default([])
  experienceLevel String?
  interests     String[] @default([])
  verifiedSkills String[] @default([])
  intent        String?
  location      String?
  website       String?
  twitter       String?
  linkedin      String?
  githubUrl     String?
  personality   String?
  status        String?
  badges        String[] @default([])
  activity      Json?    @default("[]")
  projects      Json?    @default("[]")
  builderScore  Int      @default(0)
  builderLevel  String   @default("Beginner Builder")
  profileViews  Int      @default(0)
  plan          String   @default("free") // free, pro
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  resetPasswordToken String?
  resetPasswordExpires DateTime?
  githubVerified      Boolean  @default(false)
  githubData          Json?    @default("{}")
  isBoosted           Boolean  @default(false)
  boostExpiresAt      DateTime?
  boostCount          Int      @default(0)
  reliabilityScore    Int      @default(0)
  responseTime        String   @default("2h")
  projectCompletionRate String @default("0/0")
  builderRating       Float    @default(0.0)
  activityLevel       String   @default("Active")

  // Relations
  sentLikes     Like[]    @relation("SentLikes")
  receivedLikes Like[]    @relation("ReceivedLikes")
  sentSkips     Skip[]    @relation("SentSkips")
  receivedSkips Skip[]    @relation("ReceivedSkips")
  matches1      Match[]   @relation("MatchUser1")
  matches2      Match[]   @relation("MatchUser2")
  chats         Chat[]    @relation("UserChats")
  messages      Message[]

  // Project Relations
  ownedProjects       Project[]            @relation("ProjectOwner")
  projectMemberships  ProjectMember[]      @relation("ProjectMemberships")
  projectApplications ProjectJoinRequest[] @relation("ProjectApplications")
  projectMessages     ProjectMessage[]     @relation("ProjectMessages")

  // Feed Relations
  posts               Post[]               @relation("UserPosts")
  postLikes           PostLike[]           @relation("UserPostLikes")
  comments            Comment[]            @relation("UserComments")
  pollVotes           PollVote[]

  // Hackathon Relations
  hackathonTeamMemberships HackathonTeamMember[] @relation("HackathonTeamMemberships")
  hackathonApplications    HackathonTeamJoinRequest[] @relation("HackathonApplications")
  hackathonMessages        HackathonTeamMessage[] @relation("HackathonMessages")

  // Notifications
  receivedNotifications    Notification[]         @relation("ReceivedNotifications")
  sentNotifications        Notification[]         @relation("SentNotifications")

  blocksInitiated   Block[]   @relation("Blocker")
  blocksReceived    Block[]   @relation("Blocked")
  reportsSubmitted  Report[]  @relation("Reporter")
  reportsReceived   Report[]  @relation("Reported")
  buildWorkspaceUpdates BuildWorkspaceUpdate[]

  // Profile Visitors
  profileVisitsReceived ProfileVisit[] @relation("ProfileOwner")
  profileVisitsMade     ProfileVisit[] @relation("ProfileVisitor")

  // Bounties
  bountiesOwned    Bounty[] @relation("BountyOwner")
  bountiesAssigned Bounty[] @relation("BountyAssignee")
}

// Profile Visitors - tracks who viewed whose profile
model ProfileVisit {
  id             String   @id @default(uuid())
  profileOwnerId String
  profileOwner   User     @relation("ProfileOwner", fields: [profileOwnerId], references: [id], onDelete: Cascade)
  visitorId      String
  visitor        User     @relation("ProfileVisitor", fields: [visitorId], references: [id], onDelete: Cascade)
  visitedAt      DateTime @default(now())

  @@unique([profileOwnerId, visitorId, visitedAt])
  @@index([profileOwnerId])
  @@index([visitorId])
}

model Hackathon {
  id          String   @id @default(uuid())
  title       String
  description String
  type        String   // "Online", "Local", "College"
  duration    String   // e.g. "3 Days", "48 Hours"
  location    String?  // e.g. "San Francisco, CA" or "Virtual"
  startDate   DateTime @default(now())
  endDate     DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teams       HackathonTeam[]
}

model HackathonTeam {
  id          String   @id @default(uuid())
  hackathonId String
  hackathon   Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  name        String
  description String
  lookingFor  String[] @default([])
  
  members     HackathonTeamMember[]
  requests    HackathonTeamJoinRequest[]
  messages    HackathonTeamMessage[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model HackathonTeamMember {
  id        String   @id @default(uuid())
  teamId    String
  team      HackathonTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("HackathonTeamMemberships", fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("Member") // "Creator", "Member"
  joinedAt  DateTime @default(now())

  @@unique([teamId, userId])
}

model HackathonTeamJoinRequest {
  id          String   @id @default(uuid())
  teamId      String
  team        HackathonTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  applicantId String
  applicant   User     @relation("HackathonApplications", fields: [applicantId], references: [id], onDelete: Cascade)
  message     String
  status      String   @default("Pending") // "Pending", "Accepted", "Rejected"
  createdAt   DateTime @default(now())

  @@unique([teamId, applicantId])
}

model HackathonTeamMessage {
  id        String   @id @default(uuid())
  teamId    String
  team      HackathonTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation("HackathonMessages", fields: [senderId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())
}

model Like {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  sender     User     @relation("SentLikes", fields: [senderId], references: [id])
  receiver   User     @relation("ReceivedLikes", fields: [receiverId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([senderId, receiverId])
}

model Match {
  id        String   @id @default(uuid())
  user1Id   String
  user2Id   String
  user1     User     @relation("MatchUser1", fields: [user1Id], references: [id])
  user2     User     @relation("MatchUser2", fields: [user2Id], references: [id])
  chatId    String?  @unique
  chat      Chat?    @relation(fields: [chatId], references: [id])
  createdAt DateTime @default(now())

  @@unique([user1Id, user2Id])
}

model Chat {
  id             String          @id @default(uuid())
  participants   User[]          @relation("UserChats")
  match          Match?
  messages       Message[]
  buildWorkspace BuildWorkspace?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Message {
  id        String   @id @default(uuid())
  chatId    String
  chat      Chat     @relation(fields: [chatId], references: [id])
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])
  content   String
  createdAt DateTime @default(now())
}

model Skip {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  sender     User     @relation("SentSkips", fields: [senderId], references: [id])
  receiver   User     @relation("ReceivedSkips", fields: [receiverId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([senderId, receiverId])
}

model Project {
  id          String   @id @default(uuid())
  title       String
  description String
  techStack   String[]
  lookingFor  String[]
  projectType String?
  teamSize    Int?
  location    String?  // Remote/In-person
  status      String   @default("Idea") // Idea, Building, MVP, Launched, Paused
  ownerId     String
  owner       User     @relation("ProjectOwner", fields: [ownerId], references: [id])
  
  members     ProjectMember[]
  requests    ProjectJoinRequest[]
  messages    ProjectMessage[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  userId    String
  user      User     @relation("ProjectMemberships", fields: [userId], references: [id])
  role      String   @default("Member")
  joinedAt  DateTime @default(now())

  @@unique([projectId, userId])
}

model ProjectJoinRequest {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  applicantId String
  applicant   User     @relation("ProjectApplications", fields: [applicantId], references: [id])
  message     String
  status      String   @default("Pending") // Pending, Accepted, Rejected
  createdAt   DateTime @default(now())

  @@unique([projectId, applicantId])
}

model ProjectMessage {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  senderId  String
  sender    User     @relation("ProjectMessages", fields: [senderId], references: [id])
  content   String
  createdAt DateTime @default(now())
}

model Post {
  id          String       @id @default(uuid())
  authorId    String
  author      User         @relation("UserPosts", fields: [authorId], references: [id], onDelete: Cascade)
  content     String
  imageUrl    String?
  postType    String       @default("Update") // Update, Collaboration, Achievement, GitHub, Auto, CODE_REVIEW, POLL
  codeSnippet String?      @db.Text
  language    String?
  pollOptions PollOption[]
  likes       PostLike[]
  comments    Comment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model PollOption {
  id        String     @id @default(uuid())
  postId    String
  post      Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  text      String
  votes     PollVote[]
}

model PollVote {
  id           String     @id @default(uuid())
  pollOptionId String
  pollOption   PollOption @relation(fields: [pollOptionId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([pollOptionId, userId])
}

model PostLike {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id])
  userId    String
  user      User     @relation("UserPostLikes", fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model Comment {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id])
  authorId  String
  author    User     @relation("UserComments", fields: [authorId], references: [id])
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id          String   @id @default(uuid())
  recipientId String
  recipient   User     @relation("ReceivedNotifications", fields: [recipientId], references: [id], onDelete: Cascade)
  senderId    String?
  sender      User?    @relation("SentNotifications", fields: [senderId], references: [id], onDelete: Cascade)
  type        String   // "match", "message", "project", "hackathon", "community", "follow"
  message     String
  entityId    String?  // The ID of the related entity
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Block {
  id         String   @id @default(uuid())
  blockerId  String
  blockedId  String
  blocker    User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked    User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([blockerId, blockedId])
}

model Report {
  id         String   @id @default(uuid())
  reporterId String
  reportedId String
  reporter   User     @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reported   User     @relation("Reported", fields: [reportedId], references: [id], onDelete: Cascade)
  reason     String
  details    String?
  status     String   @default("Pending") // Pending, Reviewed, Resolved, Dismissed
  createdAt  DateTime @default(now())
}


model BuildWorkspace {
  id        String   @id @default(uuid())
  chatId    String   @unique
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  goal      String   @default("")
  user1Role String   @default("Frontend")
  user2Role String   @default("Backend")
  code      String   @default("") @db.Text
  language  String   @default("typescript")
  tasks     BuildWorkspaceTask[]
  updates   BuildWorkspaceUpdate[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BuildWorkspaceTask {
  id          String   @id @default(uuid())
  workspaceId String
  workspace   BuildWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  text        String
  status      String   @default("todo")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BuildWorkspaceUpdate {
  id          String         @id @default(uuid())
  workspaceId String
  workspace   BuildWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  authorId    String
  author      User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content     String
  createdAt   DateTime       @default(now())
}

model Bounty {
  id          String   @id @default(uuid())
  title       String
  description String
  amount      Float
  status      String   @default("Open") // Open, In Progress, Completed, Cancelled
  ownerId     String
  owner       User     @relation("BountyOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  assigneeId  String?
  assignee    User?    @relation("BountyAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  skills      String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
